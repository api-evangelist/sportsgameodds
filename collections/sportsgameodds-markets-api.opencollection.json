{
  "opencollection": "1.0.0",
  "info": {
    "name": "SportsGameOdds Account Markets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Markets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Markets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sportsgameodds.com/v1/markets/",
            "params": [
              {
                "name": "sport",
                "value": "",
                "type": "query",
                "description": "Filter markets by sport"
              },
              {
                "name": "betType",
                "value": "",
                "type": "query",
                "description": "Filter by bet type"
              }
            ]
          },
          "docs": "Retrieve all supported betting market types including moneylines, spreads, totals, and props."
        }
      ]
    }
  ],
  "bundled": true
}