{
  "opencollection": "1.0.0",
  "info": {
    "name": "SportsGameOdds Account Sports API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Sports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Sports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sportsgameodds.com/v1/sports/"
          },
          "docs": "Retrieve all supported sports with their available leagues."
        }
      ]
    }
  ],
  "bundled": true
}