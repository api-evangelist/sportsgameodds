{
  "opencollection": "1.0.0",
  "info": {
    "name": "SportsGameOdds Account Teams API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sportsgameodds.com/v1/teams/",
            "params": [
              {
                "name": "sport",
                "value": "",
                "type": "query",
                "description": "Filter by sport"
              },
              {
                "name": "league",
                "value": "",
                "type": "query",
                "description": "Filter by league"
              }
            ]
          },
          "docs": "Retrieve a list of teams with optional filters for sport and league."
        },
        {
          "info": {
            "name": "Get Team",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sportsgameodds.com/v1/teams/:teamId",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "path",
                "description": "Unique team identifier"
              }
            ]
          },
          "docs": "Retrieve a specific team by its ID."
        }
      ]
    }
  ],
  "bundled": true
}