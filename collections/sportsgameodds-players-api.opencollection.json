{
  "opencollection": "1.0.0",
  "info": {
    "name": "SportsGameOdds Account Players API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Players",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Players",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sportsgameodds.com/v1/players/",
            "params": [
              {
                "name": "teamId",
                "value": "",
                "type": "query",
                "description": "Filter by team ID"
              },
              {
                "name": "sport",
                "value": "",
                "type": "query",
                "description": "Filter by sport"
              },
              {
                "name": "league",
                "value": "",
                "type": "query",
                "description": "Filter by league"
              }
            ]
          },
          "docs": "Retrieve a list of players with optional filters for team, sport, and league."
        },
        {
          "info": {
            "name": "Get Player",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sportsgameodds.com/v1/players/:playerId",
            "params": [
              {
                "name": "playerId",
                "value": "",
                "type": "path",
                "description": "Unique player identifier"
              }
            ]
          },
          "docs": "Retrieve a specific player by their ID including props odds and statistics."
        }
      ]
    }
  ],
  "bundled": true
}