{
  "opencollection": "1.0.0",
  "info": {
    "name": "SportsGameOdds Account API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Account Usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sportsgameodds.com/v1/account/usage/"
          },
          "docs": "Retrieve current API usage metrics including request counts and rate limit status."
        }
      ]
    }
  ],
  "bundled": true
}