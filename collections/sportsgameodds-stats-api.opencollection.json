{
  "opencollection": "1.0.0",
  "info": {
    "name": "SportsGameOdds Account Stats API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Stats",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Stats",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sportsgameodds.com/v1/stats/",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "query",
                "description": "Filter by event ID"
              },
              {
                "name": "sport",
                "value": "",
                "type": "query",
                "description": "Filter by sport"
              },
              {
                "name": "league",
                "value": "",
                "type": "query",
                "description": "Filter by league"
              }
            ]
          },
          "docs": "Retrieve statistical data for events with optional filters."
        }
      ]
    }
  ],
  "bundled": true
}